    <mxCell id="eiled" value="&lt;b&gt;LED 驱动&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c0392b;strokeWidth=3;fontSize=12;endArrow=classic;" edge="1" source="esp13" target="modiled" parent="1">
