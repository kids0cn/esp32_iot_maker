<mxGraphModel adaptiveColors="auto" dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1120" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;GP2Y1014AU 裸传感器 → ESP32 接线图&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 12px;&quot;&gt;无板载电路，外接件见下方 ｜ 对应代码：ZeroCarbon/src/sensor_test.cpp&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="40" y="20" width="860" height="56" as="geometry"/>
    </mxCell>

    <mxCell id="esp" value="&lt;b&gt;ESP32 开发板&lt;/b&gt;&lt;br&gt;WAVGAT CP2102 Type-C" style="swimlane;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;html=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="100" width="290" height="390" as="geometry"/>
    </mxCell>

    <mxCell id="esp5v" value="&lt;b&gt;VIN / 5V&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="esp">
      <mxGeometry x="120" y="55" width="150" height="54" as="geometry"/>
    </mxCell>

    <mxCell id="espgnd" value="&lt;b&gt;GND&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="esp">
      <mxGeometry x="120" y="125" width="150" height="54" as="geometry"/>
    </mxCell>

    <mxCell id="esp34" value="&lt;b&gt;GPIO34&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 11px;&quot;&gt;只读输入 · ADC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="esp">
      <mxGeometry x="120" y="235" width="150" height="54" as="geometry"/>
    </mxCell>

    <mxCell id="esp13" value="&lt;b&gt;GPIO13&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 11px;&quot;&gt;普通输出&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="esp">
      <mxGeometry x="120" y="305" width="150" height="54" as="geometry"/>
    </mxCell>

    <mxCell id="sens" value="&lt;b&gt;GP2Y1014AU 裸传感器&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 11px;&quot;&gt;6 脚 · 无分压无电容，全部外接&lt;/font&gt;" style="swimlane;startSize=52;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;html=1;" vertex="1" parent="1">
      <mxGeometry x="600" y="100" width="300" height="390" as="geometry"/>
    </mxCell>

    <mxCell id="svcc" value="&lt;b&gt;V-LED(1) + VCC(6)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#b45309&quot; style=&quot;font-size: 11px;&quot;&gt;1 脚串 150Ω，6 脚直连&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="sens">
      <mxGeometry x="20" y="55" width="150" height="54" as="geometry"/>
    </mxCell>

    <mxCell id="sgnd" value="&lt;b&gt;LED-GND(2) + S-GND(4)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 11px;&quot;&gt;两脚都接 GND&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="sens">
      <mxGeometry x="20" y="125" width="150" height="54" as="geometry"/>
    </mxCell>

    <mxCell id="svo" value="&lt;b&gt;Vo (5 脚)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#c0392b&quot; style=&quot;font-size: 11px;&quot;&gt;模拟输出 · 最高约 4V&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="sens">
      <mxGeometry x="20" y="235" width="150" height="54" as="geometry"/>
    </mxCell>

    <mxCell id="sled" value="&lt;b&gt;LED (3 脚)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 11px;&quot;&gt;红外 LED 驱动&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="sens">
      <mxGeometry x="20" y="305" width="150" height="54" as="geometry"/>
    </mxCell>

    <mxCell id="e5v" value="&lt;b&gt;5V&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#b45309&quot; style=&quot;font-size: 11px;&quot;&gt;1脚经 150Ω + 220µF&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=3;fontSize=12;" edge="1" source="esp5v" target="svcc" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="egnd" value="&lt;b&gt;GND&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=3;fontSize=12;" edge="1" source="espgnd" target="sgnd" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="evo" value="&lt;b&gt;经 10k/1k 分压 ÷11&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0066cc;strokeWidth=3;fontSize=12;endArrow=classic;" edge="1" source="svo" target="esp34" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="eled" value="&lt;b&gt;LED 驱动&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c0392b;strokeWidth=3;fontSize=12;endArrow=classic;" edge="1" source="esp13" target="sled" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="parts" value="&lt;b style=&quot;font-size:14px;color:#1e40af&quot;&gt;🧰 必须外接的元件（面包板上搭）&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;① 供电 RC（手册要求）&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;5V ──[150Ω]──┬── 传感器 &lt;b&gt;1 脚&lt;/b&gt; V-LED&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;└──[220µF +]── GND&amp;nbsp;&amp;nbsp;← 你已有这颗电容&lt;br&gt;&amp;nbsp;&amp;nbsp;5V ──────────────── 传感器 &lt;b&gt;6 脚&lt;/b&gt; VCC（直连，不过 150Ω）&lt;br&gt;&lt;br&gt;&lt;b&gt;② 模拟分压（★ 没有它会烧 GPIO34）&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;传感器 &lt;b&gt;5 脚&lt;/b&gt; Vo ──[10k]──┬── &lt;b&gt;GPIO34&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;└──[1k]── GND&lt;br&gt;&amp;nbsp;&amp;nbsp;GPIO34 上电压 = Vo × 1k/(10k+1k) = &lt;b&gt;Vo / 11&lt;/b&gt;&amp;nbsp;&amp;nbsp;→ 所以代码里 DIVIDER_RESTORE = 11&lt;br&gt;&lt;br&gt;&lt;b&gt;③ LED 驱动&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;GPIO13 ──────────────── 传感器 &lt;b&gt;3 脚&lt;/b&gt; LED&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b45309&quot;&gt;&lt;b&gt;⚠ 分压比必须是 10:1（10k 在上、1k 在下）。&lt;/b&gt;换了阻值就要同步改 sensor_test.cpp 里的 DIVIDER_RESTORE。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1fd;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="40" y="510" width="860" height="270" as="geometry"/>
    </mxCell>

    <mxCell id="warn" value="&lt;b style=&quot;color:#b45309;font-size:14px&quot;&gt;⚠ 上电前检查&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 传感器 &lt;b&gt;VCC 必须接 5V&lt;/b&gt;（手册 Vcc = 5±0.5V），接 3.3V 不工作&lt;br&gt;2. &lt;b&gt;GND 必须与 ESP32 共地&lt;/b&gt; —— 否则读数全是噪声&lt;br&gt;3. &lt;b style=&quot;color:#b45309&quot;&gt;★ Vo 必须经 10k/1k 分压再进 GPIO34&lt;/b&gt;：不分压时 Vo 最高约 4V，GPIO34 绝对最大 3.6V，&lt;b&gt;会打坏引脚&lt;/b&gt;&lt;br&gt;4. AOUT 只接 &lt;b&gt;GPIO34&lt;/b&gt;（只读输入脚）。&lt;b&gt;GPIO34 不能当输出用&lt;/b&gt;&lt;br&gt;5. &lt;b&gt;不要碰&lt;/b&gt;：GPIO 0 / 2（strapping，接了可能起不来）· GPIO 6–11（板载 Flash）· GPIO 1 / 3（USB 串口）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="40" y="795" width="860" height="150" as="geometry"/>
    </mxCell>

    <mxCell id="legend" value="&lt;b&gt;代码对应 &amp; 采购缺口&lt;/b&gt;&lt;br&gt;PM25_LED_PIN = 13 → 红线　·　PM25_AN_PIN = 34 → 蓝线　·　DIVIDER_RESTORE = 11（现为外接 10k/1k 实现）&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;&lt;b&gt;待采购：150Ω ×1、10k ×1、1k ×1&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;（材料清单里只有面包板和杜邦线，电阻一个都没有；220µF 传感器已附带）&lt;br&gt;&lt;font color=&quot;#b45309&quot;&gt;&lt;b&gt;⚠ LED 极性待实测：&lt;/b&gt;厂商两份例程=高电平点亮，电路图 pin3 却叫 K_LED（暗示低电平）。烧录后若读数恒定不动，把 sensor_test.cpp 里的 LED_ON_LEVEL 改成 LOW 再烧一次。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="40" y="960" width="860" height="130" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>
