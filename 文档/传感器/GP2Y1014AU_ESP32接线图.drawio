      <mxGeometry x="120" y="305" width="150" height="54" as="geometry"/>
    </mxCell>

    <mxCell id="mod" value="&lt;b&gt;GP2Y1014AU 模块&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 11px;&quot;&gt;板内已含 150Ω · 100µF×2 · 10k/1k 分压&lt;/font&gt;" style="swimlane;startSize=52;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;html=1;" vertex="1" parent="1">
